    { "name": "STENSIBLY_OAUTH_ACCESS_TOKEN_SECONDS", "type": "secret_text" },
    { "name": "STENSIBLY_OAUTH_AUTHORIZATION_CODE_SECONDS", "type": "secret_text" },
    { "name": "STENSIBLY_OAUTH_REFRESH_TOKEN_SECONDS", "type": "secret_text" },
    { "name": "STENSIBLY_OAUTH_REGISTRATION_REDIRECT_ORIGINS", "type": "plain_text", "text": "https://chatgpt.com" },
    { "name": "STENSIBLY_OAUTH_SIGNING_SECRET", "type": "secret_text" }
