+  if (ts.isMethodDeclaration(member)) {
+    return ts.factory.updateMethodDeclaration(
+      member,
+      member.modifiers,
+      member.asteriskToken,
+      member.name,
+      member.questionToken,
+      member.typeParameters,
+      parameters,
+      member.type,
+      member.body
+    ) as unknown as Member;
+  }
+  return ts.factory.updateMethodSignature(
+    member,
+    member.modifiers,
+    member.name,
+    member.questionToken,
+    member.typeParameters,
+    parameters,
+    member.type
+  ) as unknown as Member;
+}
