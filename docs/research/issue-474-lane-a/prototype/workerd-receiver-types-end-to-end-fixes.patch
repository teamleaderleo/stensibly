+function specializeMemberReceiver<
+  Member extends ts.ClassElement | ts.TypeElement,
+>(
+  member: Member,
+  typeParameters: ts.NodeArray<ts.TypeParameterDeclaration> | undefined
+): Member {
+  if (!ts.isMethodDeclaration(member) && !ts.isMethodSignature(member)) {
+    return member;
+  }
+  const receiver = getThisParameter(member);
+  if (receiver === undefined) return member;
+  const parameters = ts.factory.createNodeArray([
+    specializeReceiver(receiver, typeParameters),
+    ...member.parameters.slice(1),
