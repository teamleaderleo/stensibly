diff --git a/types/src/transforms/globals.ts b/types/src/transforms/globals.ts
--- a/types/src/transforms/globals.ts
+++ b/types/src/transforms/globals.ts
@@ -71,6 +71,48 @@ function createInlineVisitor(
   return visitor;
 }
 
+// JSG instance methods carry an explicit owning `this` parameter after type
+// generation. When one of those methods is copied into the Worker global scope,
+// preserve the Web IDL call forms for global operations:
+//
+// - bare/detached calls (`this` is `undefined`);
+// - `.call(null, ...)`;
+// - calls through `globalThis`.
+//
+// Methods without an explicit receiver are intentionally detachable (including
+// static methods) and are copied unchanged.
+function createGlobalFunctionParameters(
+  ctx: ts.TransformationContext,
+  parameters: readonly ts.ParameterDeclaration[]
+): readonly ts.ParameterDeclaration[] {
+  const receiver = parameters[0];
+  if (
+    receiver === undefined ||
+    !ts.isIdentifier(receiver.name) ||
+    receiver.name.text !== "this"
+  ) {
+    return parameters;
+  }
+
+  const receiverType = ctx.factory.createUnionTypeNode([
+    ctx.factory.createTypeQueryNode(
+      ctx.factory.createIdentifier("globalThis")
+    ),
+    ctx.factory.createLiteralTypeNode(ctx.factory.createNull()),
+    ctx.factory.createKeywordTypeNode(ts.SyntaxKind.VoidKeyword),
+  ]);
+  const globalReceiver = ctx.factory.updateParameterDeclaration(
+    receiver,
+    receiver.modifiers,
+    receiver.dotDotDotToken,
+    receiver.name,
+    receiver.questionToken,
+    receiverType,
+    receiver.initializer
+  );
+  return [globalReceiver, ...parameters.slice(1)];
+}
+
 // Call with each potential method/property that could be extracted into a
 // global function/const.
 export function maybeExtractGlobalNode(
@@ -82,12 +117,13 @@ export function maybeExtractGlobalNode(
     (ts.isMethodSignature(node) || ts.isMethodDeclaration(node)) &&
     ts.isIdentifier(node.name)
   ) {
+    const parameters = createGlobalFunctionParameters(ctx, node.parameters);
     return ctx.factory.createFunctionDeclaration(
       modifiers,
       /* asteriskToken */ undefined,
       node.name,
       node.typeParameters,
-      node.parameters,
+      parameters,
       node.type,
       /* body */ undefined
     );
