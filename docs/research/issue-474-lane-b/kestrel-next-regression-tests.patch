diff --git a/types/test/types/fetch-receiver.ts b/types/test/types/fetch-receiver.ts
--- a/types/test/types/fetch-receiver.ts
+++ b/types/test/types/fetch-receiver.ts
@@ -19,6 +19,19 @@ fromSelf.apply(globalThis, [url]);
 // @ts-expect-error An unrelated object is not a legal Worker global receiver.
 fromSelf.apply({}, [url]);
 
+// Bunyan native matrix: bind(undefined/null/globalThis), then invoke, succeeds.
+const fromSelfBoundUndefined = fromSelf.bind(undefined);
+const fromSelfBoundNull = fromSelf.bind(null);
+const fromSelfBoundGlobal = fromSelf.bind(globalThis);
+fromSelfBoundUndefined(url);
+fromSelfBoundNull(url);
+fromSelfBoundGlobal(url);
+
+// Bunyan native matrix: bind(unrelated), then invoke, throws Illegal invocation.
+// The generated declaration should reject the invalid receiver at bind time.
+// @ts-expect-error An unrelated object cannot be bound as the receiver.
+fromSelf.bind({})(url);
+
 const selfHolder = { fetch: fromSelf };
 // @ts-expect-error Property-call syntax supplies selfHolder as the receiver.
 selfHolder.fetch(url);
