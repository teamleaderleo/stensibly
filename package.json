{
  "name": "stensibly",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "mcp": "bun src/mcp-stdio.ts",
    "custodian": "bun src/custodian.ts",
    "tokens": "bun src/tokens.ts",
    "snapshot": "bun src/snapshot-cli.ts",
    "attach": "bun src/project-attach-cli.ts",
    "callsigns": "bun src/callsigns.ts",
    "callsign-catalog": "bun src/callsign-catalog-cli.ts",
    "sol-luna:worker": "bun scripts/sol-luna-worker.ts",
    "codex-roots:probe": "bun scripts/codex-root-harness-probe.ts",
    "codex-roots:memory-probe": "bun scripts/codex-root-memory-probe.ts",
    "glaeda:workstation": "bun scripts/glaeda-owned-workstation-runner.ts",
    "glaeda:verify-focused": "bun scripts/glaeda-verify-focused-runner.ts",
    "glaeda:verify-required": "bun scripts/glaeda-verify-focused-runner.ts --verification-profile required",
    "verify:hosted": "bun src/verify-hosted-cli.ts",
    "verify:oauth": "bun src/verify-oauth-hosted.ts",
    "verify:oauth-abuse": "bun src/verify-oauth-abuse.ts",
    "verify:dashboard": "bun src/verify-dashboard.ts",
    "verify:browser-artifacts": "bun scripts/verify-browser-evidence-artifacts.ts",
    "audit:membership": "bun src/provider-membership-audit-cli.ts",
    "convex:dev": "convex dev",
    "convex:local": "convex dev --dev-deployment local",
    "convex:deploy": "convex deploy",
    "worker:dev": "wrangler dev",
    "worker:check": "bun scripts/worker-bundle-check.ts",
    "worker:deploy": "bun scripts/worker-production-release.ts",
    "worker:tail": "wrangler tail",
    "lockfile:check": "bun scripts/prepare-bun-lock-candidate.ts",
    "test": "bun test ./test/*.test.ts",
    "test:browser": "playwright test",
    "test:browser:report": "playwright show-report artifacts/playwright-report",
    "test:runtime-parity": "bun scripts/verify-runtime-parity.mjs && bun test/runtime/run-mail-thread-handle-runtime.ts && node --experimental-strip-types test/runtime/run-mail-thread-handle-runtime.ts",
    "test:convex": "vitest run",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:browser": "bunx tsc --noEmit -p tsconfig.browser.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@openai/agents-core": "0.14.1",
    "ai": "7.0.58",
    "convex": "^1.42.3",
    "hono": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "1.62.0",
    "@types/bun": "latest",
    "convex-test": "^0.0.54",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.113.0"
  }
}
