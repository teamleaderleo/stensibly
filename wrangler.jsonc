{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stensibly-api",
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "minify": true,
  "routes": [
    {
      "pattern": "api.stensibly.com",
      "zone_name": "stensibly.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "STENSIBLY_WORKSPACE": "default",
    "STENSIBLY_GITHUB_PROVIDER_PROJECT": "stensibly",
    "STENSIBLY_GITHUB_PROVIDER_ACCOUNT_LOGIN": "teamleaderleo",
    "STENSIBLY_GITHUB_ISSUE_WRITES_ENABLED": "true",
    "STENSIBLY_GITHUB_PUBLICATION_WRITES_ENABLED": "true",
    "STENSIBLY_GITHUB_DELEGATED_READS_ENABLED": "true",
    "STENSIBLY_GITHUB_JOB_DETAIL_READS_ENABLED": "true",
    "STENSIBLY_DEPLOY_GOVERNOR_ENABLED": "true",
    "STENSIBLY_DEPLOY_GOVERNOR_REPOSITORY": "teamleaderleo/deploy-governor",
    "STENSIBLY_DEPLOY_GOVERNOR_REPOSITORIES": "teamleaderleo/scrapbook",
    "STENSIBLY_GITHUB_MAIL_PROJECT": "quarry",
    "STENSIBLY_GITHUB_MAIL_REPOSITORY": "Coreys-Quarry/quarry",
    "STENSIBLY_GITHUB_MAIL_PROJECT_CODE": "QRY",
    "STENSIBLY_GITHUB_PUBLIC_EVENTS_FALLBACK_ENABLED": "true",
    "STENSIBLY_OUTLOOK_MAILBOX": "cheerleaderleo@outlook.com",
    "STENSIBLY_OUTLOOK_MAILBOX_BINDING_ID": "outlook_operator_primary",
    "STENSIBLY_OUTLOOK_NOTIFICATION_URL": "https://api.stensibly.com/internal/outlook/notifications",
    "STENSIBLY_ALLOWED_ORIGINS": "https://stensibly.com,https://www.stensibly.com,https://stensibly.app,https://www.stensibly.app,https://stensibly.vercel.app",
    "STENSIBLY_OAUTH_REGISTRATION_REDIRECT_ORIGINS": "https://chatgpt.com",
    "STENSIBLY_GMAIL_MAILBOX": "leoli.4u@gmail.com",
    "STENSIBLY_GMAIL_MAILBOX_BINDING_ID": "gmail_operator_primary",
    "STENSIBLY_GMAIL_WATCH_LABEL_ID": "Label_5",
    "STENSIBLY_GMAIL_STENSIBLY_LABEL_ID": "Label_6",
    "STENSIBLY_GMAIL_PUBSUB_AUDIENCE": "https://api.stensibly.com/internal/gmail/pubsub"
  },
  "ratelimits": [
    {
      "name": "HOSTED_AUTH_START_RATE_LIMITER",
      "namespace_id": "25202",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "OAUTH_REGISTRATION_RATE_LIMITER",
      "namespace_id": "25201",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "CONVEX_URL",
      "STENSIBLY_SERVICE_SECRET",
      "STENSIBLY_GITHUB_APP_ID",
      "STENSIBLY_GITHUB_APP_PRIVATE_KEY",
      "STENSIBLY_GITHUB_INSTALLATION_ID",
      "STENSIBLY_GITHUB_WEBHOOK_SECRET",
      "STENSIBLY_GMAIL_OAUTH_CLIENT_ID",
      "STENSIBLY_GMAIL_OAUTH_CLIENT_SECRET",
      "STENSIBLY_GMAIL_OAUTH_REFRESH_TOKEN",
      "STENSIBLY_GMAIL_PUBSUB_TOPIC",
      "STENSIBLY_GMAIL_PUBSUB_SUBSCRIPTION",
      "STENSIBLY_GMAIL_PUBSUB_SERVICE_ACCOUNT",
      "STENSIBLY_OUTLOOK_OAUTH_CLIENT_ID",
      "STENSIBLY_OUTLOOK_OAUTH_REFRESH_TOKEN",
      "STENSIBLY_OUTLOOK_CLIENT_STATE",
      "STENSIBLY_OUTLOOK_FOLDER_ID"
    ]
  }
}
