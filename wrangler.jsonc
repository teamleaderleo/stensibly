{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stensibly-api",
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "minify": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "STENSIBLY_WORKSPACE": "default",
    "STENSIBLY_GITHUB_PROVIDER_PROJECT": "stensibly",
    "STENSIBLY_GITHUB_PROVIDER_ACCOUNT_LOGIN": "teamleaderleo",
    "STENSIBLY_GITHUB_ISSUE_WRITES_ENABLED": "true",
    "STENSIBLY_GITHUB_DELEGATED_READS_ENABLED": "true",
    "STENSIBLY_GITHUB_JOB_DETAIL_READS_ENABLED": "true",
    "STENSIBLY_ALLOWED_ORIGINS": "https://stensibly.com,https://www.stensibly.com,https://stensibly.app,https://www.stensibly.app,https://stensibly.vercel.app",
    "STENSIBLY_OAUTH_REGISTRATION_REDIRECT_ORIGINS": "https://chatgpt.com"
  },
  "ratelimits": [
    {
      "name": "OAUTH_REGISTRATION_RATE_LIMITER",
      "namespace_id": "25201",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "CONVEX_URL",
      "STENSIBLY_SERVICE_SECRET",
      "STENSIBLY_GITHUB_APP_ID",
      "STENSIBLY_GITHUB_APP_PRIVATE_KEY",
      "STENSIBLY_GITHUB_INSTALLATION_ID",
      "STENSIBLY_GITHUB_WEBHOOK_SECRET"
    ]
  }
}
